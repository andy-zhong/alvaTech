{
  "name": "vendure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node ./src/index.ts",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "dev:dashboard": "vite --clearScreen false",
    "dev": "concurrently --kill-others npm:dev:*",
    "setup:local": "npm run configure:alva && npm run seed:alva && npm run catalog:disable-demo",
    "configure:alva": "ts-node ./src/scripts/configure-alva-channel.ts",
    "payments:configure-stripe": "ts-node ./src/scripts/configure-stripe-payment.ts",
    "seed:alva": "ts-node ./src/scripts/seed-alva-catalog.ts",
    "catalog:disable-demo": "ts-node ./src/scripts/disable-demo-catalog.ts --apply",
    "catalog:disable-demo:dry-run": "ts-node ./src/scripts/disable-demo-catalog.ts",
    "orders:cleanup": "ts-node ./src/scripts/cleanup-test-orders.ts --apply",
    "orders:cleanup:dry-run": "ts-node ./src/scripts/cleanup-test-orders.ts",
    "build": "tsc",
    "build:dashboard": "vite build",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "start": "concurrently npm:start:*"
  },
  "dependencies": {
    "@vendure-community/stripe-plugin": "^1.0.0",
    "@vendure/asset-server-plugin": "3.6.3",
    "@vendure/core": "3.6.3",
    "@vendure/dashboard": "3.6.3",
    "@vendure/email-plugin": "3.6.3",
    "@vendure/graphiql-plugin": "3.6.3",
    "better-sqlite3": "12.10.0",
    "dotenv": "17.4.2",
    "stripe": "^13.11.0"
  },
  "devDependencies": {
    "@vendure/cli": "3.6.3",
    "concurrently": "9.2.1",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  }
}
