PORT=3000
NODE_ENV=production

# Comma-separated frontend origins. Keep old public domains here while staging is tested.
# Staging example: https://staging.alvatechnology.com,https://new.alvatechnology.com
# Production example: https://www.alvatechnology.com,https://alvatechnology.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Inquiry email delivery.
EMAIL_USER=
EMAIL_PASS=
SALES_EMAIL=
COMPANY_EMAIL=

# Optional SMTP values used by the quote route.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Legacy analytics/Postgres settings. Leave unused until analytics DB is deployed.
DB_USER=
DB_HOST=localhost
DB_NAME=alva_db
DB_PASSWORD=
DB_PORT=5432

# Required only if legacy analytics admin endpoints are exposed.
JWT_SECRET=

# Payment integration placeholders. Use test keys on staging only.
# Do not set live keys until the company merchant account and bank payout account are approved.
PAYMENT_MODE=order_request
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_METHODS=card,klarna
