# AlvaTechWeb Docker / 1Panel environment reference
#
# Copy this file to the directory that contains your docker-compose.yml as
# `.env`, then replace every placeholder value before starting containers.
# Do not commit real secrets.

# PostgreSQL container initialization.
POSTGRES_DB=alva_staging
POSTGRES_USER=alva_vendure
POSTGRES_PASSWORD=replace-with-database-password

# Vendure runtime.
NODE_ENV=production
APP_ENV=production
PORT=2605
STOREFRONT_URL=https://staging.alvatechnology.com
STOREFRONT_ORIGINS=https://staging.alvatechnology.com,https://new.alvatechnology.com

# Required Vendure secrets and admin bootstrap credentials.
COOKIE_SECRET=replace-with-long-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-with-strong-admin-password

# Vendure database connection.
# In Docker Compose, DB_HOST must be the Postgres service name, not 127.0.0.1.
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=alva_staging
DB_USERNAME=alva_vendure
DB_PASSWORD=replace-with-same-value-as-postgres-password

# Use true only for the first startup against an empty staging database.
# Set back to false after Vendure has created the schema successfully.
DB_SYNCHRONIZE=false

# Stripe / payment runtime.
# Keep order_request until Stripe test payments are fully implemented.
PAYMENT_MODE=order_request
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_METHODS=card,klarna

# Optional Express API values if the legacy Express server is deployed from
# the same env file.
EXPRESS_PORT=3000
CORS_ORIGIN=https://staging.alvatechnology.com,https://new.alvatechnology.com
EMAIL_USER=
EMAIL_PASS=
SALES_EMAIL=
COMPANY_EMAIL=
